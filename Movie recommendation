import gradio as gr

def movie_recommender_advanced(movie_title, top_n):
    """
    Returns:
    1. Movie overview
    2. Recommended movies with similarity score
    3. Predicted popularity (ML model)
    """

    if movie_title not in df_filtered['Movie_Title'].values:
        return "âŒ Movie not found.", "", ""

    # Index of selected movie
    idx = df_filtered[df_filtered['Movie_Title'] == movie_title].index[0]

    # Movie overview
    overview = df_filtered.loc[idx, 'Movie_Overview']

    # Similarity scores
    similarity_scores = list(enumerate(cosine_sim[idx]))
    similarity_scores = sorted(
        similarity_scores, key=lambda x: x[1], reverse=True
    )[1:top_n+1]

    recommendations = []
    for i, score in similarity_scores:
        recommendations.append(
            f"ðŸŽ¬ {df_filtered.iloc[i]['Movie_Title']}  |  Similarity: {round(score*100, 2)}%"
        )

    # Prepare ML features for popularity prediction
    movie_row = df_filtered.loc[idx]

    input_features = pd.DataFrame([{
        'Budget_Log': np.log1p(movie_row['Movie_Budget']),
        'Revenue_Log': np.log1p(movie_row['Movie_Revenue']),
        'Movie_Runtime': movie_row['Movie_Runtime'],
        'Movie_Vote': movie_row['Movie_Vote'],
        'Movie_Vote_Count': movie_row['Movie_Vote_Count'],
        'Vote_Weighted': movie_row['Movie_Vote'] * movie_row['Movie_Vote_Count']
    }])

    predicted_popularity = rf_model.predict(input_features)[0]

    return (
        overview,
        "\n".join(recommendations),
        f"ðŸ“ˆ Predicted Popularity (log scale): {round(predicted_popularity, 2)}"
    )


